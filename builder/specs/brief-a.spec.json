{
  "meta": {
    "bank_name": "Freya Bank",
    "language": "en",
    "multi_product": false,
    "max_products": 1,
    "job": "Early-stage collections calls to customers 1 to 45 days late on one product: find the customer, check identity, state the debt, get a payment promise where possible, close with the correct outcome."
  },
  "call_variables": [
    {
      "name": "customer_id",
      "meaning": "pass to every tool call"
    },
    {
      "name": "first_name",
      "meaning": "the person to ask for"
    },
    {
      "name": "last_name",
      "meaning": "the person to ask for"
    },
    {
      "name": "title",
      "meaning": "Mr or Ms; address the customer as title plus last name"
    },
    {
      "name": "now",
      "format": "YYYY-MM-DDTHH:MM",
      "meaning": "current date and time; all date rules use this, never the real clock"
    }
  ],
  "opening": {
    "first_sentence_must_include": [
      "digital assistant",
      "calling from Freya Bank",
      "call is recorded"
    ],
    "forbidden_words_before_verification": [
      "collections",
      "debt",
      "payment"
    ],
    "forbid_product_name_before_verification": true,
    "applies_to_everyone_including_relatives": true,
    "confirm_identity_question": "Am I speaking with {title} {last_name}?",
    "accepted_confirmations": [
      "yes",
      "that's me",
      "speaking",
      "<customer's own name>"
    ],
    "not_confirmations": [
      "hello",
      "go ahead",
      "who is this"
    ],
    "max_confirmation_asks": 2,
    "question_answered_before_next_ask": true,
    "on_unclear": {
      "outcome": "not_reached",
      "reason": "unclear"
    },
    "ai_question_answer": "I am Freya Bank's digital assistant."
  },
  "third_party": {
    "say_nothing_beyond_opening": true,
    "ask_when_can_be_reached": true,
    "callback": {
      "allowed_days": "today_or_next_business_day",
      "window_start": "10:00",
      "window_end": "19:00",
      "inclusive": true,
      "must_be_after_now": true,
      "max_out_of_window_asks": 1,
      "tool": "schedule_callback",
      "on_scheduled": {
        "outcome": "not_reached",
        "reason": "callback"
      },
      "on_failed": {
        "outcome": "not_reached",
        "reason": "no_callback"
      }
    },
    "wrong_number": {
      "outcome": "not_reached",
      "reason": "wrong_number"
    },
    "deceased": {
      "say": "I am sorry for your loss.",
      "ask_nothing_else": true,
      "outcome": "not_reached",
      "reason": "deceased"
    },
    "relative_may_not_verify_or_pay": true
  },
  "identity": {
    "questions": [
      {
        "field": "date_of_birth",
        "ask": "your date of birth",
        "format": "YYYY-MM-DD",
        "numeric_date_order": "DMY"
      },
      {
        "field": "phone_last4",
        "ask": "the last four digits of the phone number on file",
        "format": "4 digits"
      }
    ],
    "one_at_a_time": true,
    "tool": "verify_identity",
    "max_wrong_answers_total": 3,
    "hints": [
      {
        "hint": "day_month_swapped",
        "action": "ask them to say the month as a word",
        "counts_as_wrong": false
      }
    ],
    "on_failed": {
      "do_not_state_debt": true,
      "say": "use the mobile app or a branch",
      "outcome": "not_verified",
      "reason": "failed"
    },
    "on_declined": {
      "explain_once": "the questions protect your account",
      "max_refusals": 2,
      "outcome": "not_verified",
      "reason": "declined",
      "asking_purpose_counts_as_refusal": true
    }
  },
  "debt_statement": {
    "after": "get_account",
    "say": "calling from the collections team about a late payment",
    "product_names": {
      "credit_card": "credit card ending {card_last4}",
      "personal_loan": "personal loan",
      "car_loan": "car loan"
    },
    "include": [
      "past_due",
      "days_late"
    ]
  },
  "calendar": {
    "business_days": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri"
    ],
    "holidays": [
      "2026-10-26",
      "2026-11-11",
      "2026-11-26",
      "2026-12-25",
      "2027-01-01"
    ]
  },
  "bands": [
    {
      "name": "early",
      "days_late_min": 1,
      "days_late_max": 7,
      "deadline": {
        "business_days_after_today": 12
      },
      "persuasion_attempts": 1
    },
    {
      "name": "late",
      "days_late_min": 8,
      "days_late_max": 45,
      "deadline": {
        "business_days_after_today": 7
      },
      "persuasion_attempts": 2
    }
  ],
  "dates": {
    "promise_date_rule": "today_or_later AND business_day AND <= deadline",
    "non_business_day_before_deadline": "offer_next_business_day",
    "after_deadline": "say the latest date you can record is the deadline and offer it; refusal of the deadline = flat refusal",
    "vague_period": "ask_once_then_propose_deadline",
    "next_weekday_means": "following_calendar_week",
    "this_weekday_means": "current_week",
    "examples": [
      "\"next Friday\" said on a Friday is the Friday of the following week"
    ]
  },
  "amounts": {
    "first_ask": "full_past_due",
    "never_ask_customer_for_amount": true,
    "agent_proposes_every_amount": true,
    "floor_field_by_product": {
      "credit_card": "minimum_payment",
      "personal_loan": "instalment_amount",
      "car_loan": "instalment_amount"
    },
    "floor_offers": 1,
    "floor_note": "say the rest stays overdue",
    "accept_range": "floor <= amount <= past_due",
    "below_floor": "say it cannot be recorded and offer the floor once; refusal = flat refusal"
  },
  "persuasion": {
    "first_question": "Can you make this payment today?",
    "customer_proposed_date_or_amount_is_never_a_refusal": true,
    "flat_refusal_definition": "a no to paying today with no date and no amount, or a non-answer; each uses one persuasion attempt",
    "attempts": [
      {
        "n": 1,
        "amount": "full_past_due, or floor if the customer already said the full amount is too much",
        "date": "last business day of this week; if today is that day, last business day of next week"
      },
      {
        "n": 2,
        "amount": "floor",
        "date": "deadline",
        "bands": [
          "late"
        ]
      }
    ],
    "do_not_repeat_refused_offer": true,
    "on_exhausted": {
      "outcome": "no_promise",
      "reason": "refused"
    }
  },
  "confirmation": {
    "readback": [
      "product",
      "amount",
      "date"
    ],
    "confirm_question": "Do you confirm?",
    "create_only_after_clear_yes": true,
    "recheck_changes_against": [
      "dates",
      "amounts"
    ],
    "one_promise_per_product": true,
    "change_after_record": "say they can change it in the mobile app; a recorded promise cannot be changed or cancelled in the same call",
    "tool": "create_promise",
    "say_recorded_only_if_ok_true": true,
    "create_promise_max_tries": 2,
    "on_create_failed": {
      "say": "you could not record it",
      "outcome": "no_promise",
      "reason": "service_error"
    },
    "after_recorded_say": "You will receive a text message confirming this promise."
  },
  "intents": [
    {
      "id": "already_paid",
      "say": "payments can take one business day to appear",
      "no_promise": true,
      "action": {
        "close": {
          "outcome": "paid",
          "reason": null
        }
      },
      "source": "39"
    },
    {
      "id": "dispute",
      "description": "debt is not mine, never had this product, product closed or paid off in the past (not a payment of this past-due amount)",
      "do_not_argue": true,
      "no_promise": true,
      "action": {
        "close": {
          "outcome": "no_promise",
          "reason": "dispute"
        }
      },
      "source": "40"
    },
    {
      "id": "restructuring",
      "description": "request for a new payment plan or lower instalments; do not describe a plan",
      "action": {
        "transfer": "restructuring",
        "close": {
          "outcome": "transferred",
          "reason": "restructuring"
        }
      },
      "source": "41"
    },
    {
      "id": "human",
      "ask_once_first": "ask whether you can help first",
      "applies": "before_and_after_verification",
      "action": {
        "transfer": "general",
        "close": {
          "outcome": "transferred",
          "reason": "human"
        }
      },
      "source": "42"
    },
    {
      "id": "hardship",
      "description": "illness, death in the family or job loss",
      "say": "one short sentence of sympathy",
      "no_persuasion": true,
      "offer_transfer": "support",
      "overrides": [
        "30",
        "41"
      ],
      "promise_if_customer_names_date_or_amount": true,
      "on_accept": {
        "transfer": "support",
        "close": {
          "outcome": "transferred",
          "reason": "support"
        }
      },
      "on_decline": {
        "close": {
          "outcome": "no_promise",
          "reason": "hardship"
        }
      },
      "source": "32"
    },
    {
      "id": "scam",
      "say": "you can verify this call by phoning Freya Bank's customer service number",
      "continue": true,
      "source": "43"
    },
    {
      "id": "unknown_question",
      "description": "a question that cannot be answered from the tools",
      "say": "I do not have that information",
      "never_invent": [
        "figures",
        "dates",
        "reasons"
      ],
      "continue": true,
      "source": "44"
    },
    {
      "id": "does_not_want_to_talk",
      "max": 2,
      "close_verified": {
        "outcome": "no_promise",
        "reason": "refused"
      },
      "close_unverified": {
        "outcome": "not_verified",
        "reason": "declined"
      },
      "source": "45"
    }
  ],
  "multi_product": null,
  "closing": {
    "goodbye_before_close": true,
    "close_tool": "close_call",
    "exactly_one_close_call_and_it_is_last": true,
    "outcomes": [
      {
        "outcome": "promise",
        "reasons": [],
        "when": "at least one promise was recorded"
      },
      {
        "outcome": "paid",
        "reasons": [],
        "when": "rule 39"
      },
      {
        "outcome": "transferred",
        "reasons": [
          "restructuring",
          "human",
          "support"
        ],
        "when": "rules 41, 42, 32"
      },
      {
        "outcome": "no_promise",
        "reasons": [
          "refused",
          "hardship",
          "dispute",
          "service_error"
        ],
        "when": "rules 31 and 45, 32, 40, 37"
      },
      {
        "outcome": "not_verified",
        "reasons": [
          "failed",
          "declined"
        ],
        "when": "rules 14, 15"
      },
      {
        "outcome": "not_reached",
        "reasons": [
          "callback",
          "no_callback",
          "wrong_number",
          "deceased",
          "unclear"
        ],
        "when": "rules 6, 7, 8, 9, 3"
      }
    ],
    "transfer_after_promise": "close as transferred with the transfer reason",
    "unused_tools": [
      "add_note"
    ],
    "forbidden_offers": [
      "discount",
      "waiver",
      "instalment plan",
      "any term not in the brief"
    ]
  },
  "tools_server": "https://freya-bank-mock.freyavoice.workers.dev/v1",
  "tools": {
    "verify_identity": {
      "summary": "Check one security answer. Three wrong answers in total end the check.",
      "method": "POST",
      "path": "/verify_identity",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "field": {
          "type": "string",
          "enum": [
            "date_of_birth",
            "phone_last4"
          ],
          "required": true
        },
        "answer": {
          "type": "string",
          "description": "For date_of_birth: the date as YYYY-MM-DD. Callers say dates in words, the agent converts. An unreadable value is rejected with ok=false and is not counted as a wrong answer. For phone_last4: four digits.",
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        },
        "verified": {
          "type": "boolean",
          "required": false
        },
        "wrong_answers_left": {
          "type": "integer",
          "required": false
        },
        "all_verified": {
          "type": "boolean",
          "required": false
        },
        "hint": {
          "type": "string",
          "enum": [
            "day_month_swapped"
          ],
          "required": false
        }
      }
    },
    "get_account": {
      "summary": "The late products. Refused until both questions are passed.",
      "method": "POST",
      "path": "/get_account",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        },
        "products": {
          "type": "array",
          "items": {
            "product_id": {
              "type": "string",
              "required": false
            },
            "type": {
              "type": "string",
              "enum": [
                "credit_card",
                "personal_loan",
                "car_loan"
              ],
              "required": false
            },
            "card_last4": {
              "type": "string",
              "description": "credit cards only",
              "required": false
            },
            "past_due": {
              "type": "number",
              "required": false
            },
            "days_late": {
              "type": "integer",
              "required": false
            },
            "minimum_payment": {
              "type": "number",
              "description": "credit cards only",
              "required": false
            },
            "instalment_amount": {
              "type": "number",
              "description": "loans only",
              "required": false
            }
          },
          "required": false
        }
      }
    },
    "create_promise": {
      "summary": "Record a payment promise. One per product.",
      "method": "POST",
      "path": "/create_promise",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "product_id": {
          "type": "string",
          "required": true
        },
        "amount": {
          "type": "number",
          "required": true
        },
        "date": {
          "type": "string",
          "format": "date",
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        },
        "promise_id": {
          "type": "string",
          "required": false
        }
      }
    },
    "add_note": {
      "summary": "Brief B: record why a product ended without a promise.",
      "method": "POST",
      "path": "/add_note",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "product_id": {
          "type": "string",
          "required": true
        },
        "reason": {
          "type": "string",
          "enum": [
            "refused",
            "hardship",
            "dispute",
            "paid",
            "service_error"
          ],
          "required": true
        },
        "text": {
          "type": "string",
          "required": false
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        }
      }
    },
    "schedule_callback": {
      "summary": "Book a callback.",
      "method": "POST",
      "path": "/schedule_callback",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "date": {
          "type": "string",
          "format": "date",
          "required": true
        },
        "time": {
          "type": "string",
          "description": "HH:MM",
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        }
      }
    },
    "transfer_to_agent": {
      "summary": "Hand the call to a person.",
      "method": "POST",
      "path": "/transfer_to_agent",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "queue": {
          "type": "string",
          "enum": [
            "restructuring",
            "general",
            "support"
          ],
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        }
      }
    },
    "close_call": {
      "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
      "method": "POST",
      "path": "/close_call",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "outcome": {
          "type": "string",
          "enum": [
            "promise",
            "paid",
            "transferred",
            "no_promise",
            "not_verified",
            "not_reached"
          ],
          "required": true
        },
        "reason": {
          "type": "string",
          "description": "Required for every outcome except promise and paid. See the table in the brief.",
          "required": false
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        }
      }
    }
  },
  "extra_rules": [
    {
      "source": "3",
      "text": "If the customer asks a question before confirming who they are (rules 4 and 43), answer it first; the identity ask that follows is the second ask."
    },
    {
      "source": "4",
      "text": "If asked whether you are a robot or an AI, say you are Freya Bank's digital assistant and continue."
    },
    {
      "source": "10",
      "text": "A relative may not answer the security questions and may not be told anything about the account, even if they offer to pay."
    },
    {
      "source": "11",
      "text": "Send a date of birth to verify_identity as YYYY-MM-DD whatever way the customer said it; the service rejects anything it cannot read as a date. A date given only as numbers is read as day, then month, then year."
    },
    {
      "source": "12",
      "text": "A wrong answer may be asked again; three wrong answers in total, on whichever question, end the check."
    },
    {
      "source": "30",
      "text": "A no to paying today with no date and no amount is a flat refusal; a date or amount the customer proposes is never a refusal."
    },
    {
      "source": "33",
      "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in the brief."
    },
    {
      "source": "36",
      "text": "A recorded promise cannot be changed or cancelled in the same call; if asked, say they can change it in the mobile app."
    },
    {
      "source": "p7",
      "text": "Brief A never uses add_note."
    }
  ],
  "rule_coverage": {
    "p1": "context: synthetic data note",
    "p2": "context: read all rules",
    "p3": "meta.job; bands",
    "p4": "call_variables",
    "t1": "call_variables",
    "1": "opening.first_sentence_must_include; opening.forbidden_words_before_verification; opening.forbid_product_name_before_verification; opening.applies_to_everyone_including_relatives",
    "2": "opening.confirm_identity_question",
    "3": "opening.accepted_confirmations; opening.not_confirmations; opening.max_confirmation_asks; opening.on_unclear; opening.question_answered_before_next_ask; extra_rules[3]",
    "4": "opening.ai_question_answer; extra_rules[4]",
    "5": "third_party.say_nothing_beyond_opening; third_party.ask_when_can_be_reached",
    "6": "third_party.callback",
    "7": "third_party.callback.max_out_of_window_asks; third_party.callback.on_failed",
    "8": "third_party.wrong_number",
    "9": "third_party.deceased",
    "10": "third_party.relative_may_not_verify_or_pay; extra_rules[10]",
    "11": "identity.questions; identity.one_at_a_time; identity.tool; extra_rules[11]",
    "12": "identity.max_wrong_answers_total; extra_rules[12]",
    "13": "identity.hints",
    "14": "identity.on_failed",
    "15": "identity.on_declined",
    "16": "debt_statement.after",
    "17": "debt_statement",
    "p5": "calendar",
    "18": "bands",
    "t2": "bands",
    "19": "dates.promise_date_rule",
    "20": "dates.non_business_day_before_deadline",
    "21": "dates.vague_period",
    "22": "dates.next_weekday_means; dates.this_weekday_means; dates.examples",
    "23": "dates.after_deadline",
    "24": "amounts.first_ask; amounts.never_ask_customer_for_amount; amounts.agent_proposes_every_amount",
    "25": "amounts.floor_field_by_product",
    "26": "amounts.floor_offers; amounts.floor_note",
    "27": "amounts.accept_range; amounts.below_floor",
    "28": "persuasion.first_question",
    "29": "persuasion.customer_proposed_date_or_amount_is_never_a_refusal",
    "30": "persuasion.flat_refusal_definition; persuasion.attempts; extra_rules[30]",
    "31": "persuasion.do_not_repeat_refused_offer; persuasion.on_exhausted",
    "32": "intents[hardship]",
    "33": "closing.forbidden_offers; extra_rules[33]",
    "34": "confirmation.readback; confirmation.confirm_question; confirmation.create_only_after_clear_yes",
    "35": "confirmation.recheck_changes_against",
    "36": "confirmation.one_promise_per_product; confirmation.change_after_record; extra_rules[36]",
    "37": "confirmation.say_recorded_only_if_ok_true; confirmation.create_promise_max_tries; confirmation.on_create_failed",
    "38": "confirmation.after_recorded_say",
    "39": "intents[already_paid]",
    "40": "intents[dispute]",
    "41": "intents[restructuring]",
    "42": "intents[human]",
    "43": "intents[scam]",
    "44": "intents[unknown_question]",
    "45": "intents[does_not_want_to_talk]",
    "46": "closing.close_tool; closing.exactly_one_close_call_and_it_is_last; closing.outcomes",
    "t3": "closing.outcomes",
    "p6": "closing.transfer_after_promise",
    "p7": "closing.unused_tools; extra_rules[p7]",
    "47": "closing.goodbye_before_close"
  }
}
