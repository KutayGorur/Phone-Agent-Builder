{
  "meta": {
    "bank_name": "Freya Bank",
    "language": "en",
    "multi_product": true,
    "max_products": 3,
    "job": "Early-stage collections calls to customers 1 to 45 days late on up to three products: find the customer, check identity, state every late product, get a payment promise per product where possible, note why products end without a promise, close with the correct outcome. Brief A with the changes of Brief B."
  },
  "call_variables": [
    {
      "name": "customer_id",
      "meaning": "pass to every tool call"
    },
    {
      "name": "first_name",
      "meaning": "the person to ask for"
    },
    {
      "name": "last_name",
      "meaning": "the person to ask for"
    },
    {
      "name": "title",
      "meaning": "Mr or Ms; address the customer as title plus last name"
    },
    {
      "name": "now",
      "format": "YYYY-MM-DDTHH:MM",
      "meaning": "current date and time; all date rules use this, never the real clock"
    }
  ],
  "opening": {
    "first_sentence_must_include": [
      "digital assistant",
      "calling from Freya Bank",
      "call is recorded"
    ],
    "forbidden_words_before_verification": [
      "collections",
      "debt",
      "payment"
    ],
    "forbid_product_name_before_verification": true,
    "applies_to_everyone_including_relatives": true,
    "confirm_identity_question": "Am I speaking with {title} {last_name}?",
    "accepted_confirmations": [
      "yes",
      "that's me",
      "speaking",
      "<customer's own name>"
    ],
    "not_confirmations": [
      "hello",
      "go ahead",
      "who is this"
    ],
    "max_confirmation_asks": 2,
    "question_answered_before_next_ask": true,
    "on_unclear": {
      "outcome": "not_reached",
      "reason": "unclear"
    },
    "ai_question_answer": "I am Freya Bank's digital assistant."
  },
  "third_party": {
    "say_nothing_beyond_opening": true,
    "ask_when_can_be_reached": true,
    "callback": {
      "allowed_days": "today_or_next_business_day",
      "window_start": "10:00",
      "window_end": "19:00",
      "inclusive": true,
      "must_be_after_now": true,
      "max_out_of_window_asks": 1,
      "tool": "schedule_callback",
      "on_scheduled": {
        "outcome": "not_reached",
        "reason": "callback"
      },
      "on_failed": {
        "outcome": "not_reached",
        "reason": "no_callback"
      }
    },
    "wrong_number": {
      "outcome": "not_reached",
      "reason": "wrong_number"
    },
    "deceased": {
      "say": "I am sorry for your loss.",
      "ask_nothing_else": true,
      "outcome": "not_reached",
      "reason": "deceased"
    },
    "relative_may_not_verify_or_pay": true
  },
  "identity": {
    "questions": [
      {
        "field": "date_of_birth",
        "ask": "your date of birth",
        "format": "YYYY-MM-DD",
        "numeric_date_order": "DMY"
      },
      {
        "field": "phone_last4",
        "ask": "the last four digits of the phone number on file",
        "format": "4 digits"
      }
    ],
    "one_at_a_time": true,
    "tool": "verify_identity",
    "max_wrong_answers_total": 3,
    "hints": [
      {
        "hint": "day_month_swapped",
        "action": "ask them to say the month as a word",
        "counts_as_wrong": false
      }
    ],
    "on_failed": {
      "do_not_state_debt": true,
      "say": "use the mobile app or a branch",
      "outcome": "not_verified",
      "reason": "failed"
    },
    "on_declined": {
      "explain_once": "the questions protect your account",
      "max_refusals": 2,
      "outcome": "not_verified",
      "reason": "declined",
      "asking_purpose_counts_as_refusal": true
    }
  },
  "debt_statement": {
    "after": "get_account",
    "say": "calling from the collections team about a late payment",
    "product_names": {
      "credit_card": "credit card ending {card_last4}",
      "personal_loan": "personal loan",
      "car_loan": "car loan"
    },
    "include": [
      "past_due",
      "days_late"
    ],
    "state_every_late_product": "one sentence each, before asking for anything",
    "order": "get_account order",
    "per_product_sentence": "product name, past_due, days_late"
  },
  "calendar": {
    "business_days": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri"
    ],
    "holidays": [
      "2026-10-26",
      "2026-11-11",
      "2026-11-26",
      "2026-12-25",
      "2027-01-01"
    ]
  },
  "bands": [
    {
      "name": "early",
      "days_late_min": 1,
      "days_late_max": 7,
      "deadline": {
        "business_days_after_today": 12
      },
      "persuasion_attempts": 1
    },
    {
      "name": "late",
      "days_late_min": 8,
      "days_late_max": 45,
      "deadline": {
        "business_days_after_today": 7
      },
      "persuasion_attempts": 2
    }
  ],
  "dates": {
    "promise_date_rule": "today_or_later AND business_day AND <= deadline",
    "non_business_day_before_deadline": "offer_next_business_day",
    "after_deadline": "say the latest date you can record is the deadline and offer it; refusal of the deadline = flat refusal",
    "vague_period": "ask_once_then_propose_deadline",
    "next_weekday_means": "following_calendar_week",
    "this_weekday_means": "current_week",
    "examples": [
      "\"next Friday\" said on a Friday is the Friday of the following week"
    ]
  },
  "amounts": {
    "first_ask": "full_past_due",
    "never_ask_customer_for_amount": true,
    "agent_proposes_every_amount": true,
    "floor_field_by_product": {
      "credit_card": "minimum_payment",
      "personal_loan": "instalment_amount",
      "car_loan": "instalment_amount"
    },
    "floor_offers": 1,
    "floor_note": "say the rest stays overdue",
    "accept_range": "floor <= amount <= past_due",
    "below_floor": "say it cannot be recorded and offer the floor once; refusal = flat refusal"
  },
  "persuasion": {
    "first_question": "Can you make this payment today?",
    "customer_proposed_date_or_amount_is_never_a_refusal": true,
    "flat_refusal_definition": "a no to paying today with no date and no amount, or a non-answer; each uses one persuasion attempt",
    "attempts": [
      {
        "n": 1,
        "amount": "full_past_due, or floor if the customer already said the full amount is too much",
        "date": "last business day of this week; if today is that day, last business day of next week"
      },
      {
        "n": 2,
        "amount": "floor",
        "date": "deadline",
        "bands": [
          "late"
        ]
      }
    ],
    "do_not_repeat_refused_offer": true,
    "on_exhausted": {
      "outcome": "no_promise",
      "reason": "refused"
    },
    "per_product": true,
    "attempts_counted_per_product": true,
    "each_product_starts_at_attempt_1": true,
    "first_question_multi": "ask whether the customer can pay all of them today; if not, go through the products one by one in get_account order; do not ask about today again for each product"
  },
  "confirmation": {
    "readback": [
      "product",
      "amount",
      "date"
    ],
    "confirm_question": "Do you confirm?",
    "create_only_after_clear_yes": true,
    "recheck_changes_against": [
      "dates",
      "amounts"
    ],
    "one_promise_per_product": true,
    "change_after_record": "say they can change it in the mobile app; a recorded promise cannot be changed or cancelled in the same call",
    "tool": "create_promise",
    "say_recorded_only_if_ok_true": true,
    "create_promise_max_tries": 2,
    "on_create_failed": {
      "say": "you could not record it",
      "outcome": "no_promise",
      "reason": "service_error",
      "replaced_by": "multi_product.create_promise_failure"
    },
    "after_recorded_say": "You will receive a text message confirming this promise.",
    "single_confirmation_for_all": true,
    "readback_scope": "all promises together, then one confirmation",
    "create_promise_calls": "once per product after the single confirmation",
    "one_date_for_everything_after_a_deadline": "record that product on its own deadline and say so in the read-back; the other products keep the date the customer named"
  },
  "intents": [
    {
      "id": "already_paid",
      "say": "payments can take one business day to appear",
      "no_promise": true,
      "action": {
        "note": {
          "reason": "paid"
        },
        "continue_with_other_products": true,
        "close_when_no_products_left": "per closing rule"
      },
      "source": "a:39",
      "single_product_action_replaced_by": "b:9"
    },
    {
      "id": "dispute",
      "description": "debt is not mine, never had this product, product closed or paid off in the past (not a payment of this past-due amount)",
      "do_not_argue": true,
      "no_promise": true,
      "action": {
        "note": {
          "reason": "dispute"
        },
        "continue_with_other_products": true,
        "close_when_no_products_left": "per closing rule"
      },
      "source": "a:40",
      "single_product_action_replaced_by": "b:9"
    },
    {
      "id": "restructuring",
      "description": "request for a new payment plan or lower instalments; do not describe a plan",
      "action": {
        "transfer": "restructuring",
        "close": {
          "outcome": "transferred",
          "reason": "restructuring"
        }
      },
      "source": "a:41",
      "no_notes": true
    },
    {
      "id": "human",
      "ask_once_first": "ask whether you can help first",
      "applies": "before_and_after_verification",
      "action": {
        "transfer": "general",
        "close": {
          "outcome": "transferred",
          "reason": "human"
        }
      },
      "source": "a:42",
      "no_notes": true
    },
    {
      "id": "hardship",
      "description": "illness, death in the family or job loss",
      "say": "one short sentence of sympathy",
      "no_persuasion": true,
      "offer_transfer": "support",
      "overrides": [
        "a:30",
        "a:41"
      ],
      "promise_if_customer_names_date_or_amount": true,
      "on_accept": {
        "transfer": "support",
        "close": {
          "outcome": "transferred",
          "reason": "support"
        },
        "no_notes": true
      },
      "on_decline": {
        "note": {
          "reason": "hardship"
        },
        "applies_to": "products without a promise",
        "close": "per closing rule"
      },
      "source": "a:32"
    },
    {
      "id": "scam",
      "say": "you can verify this call by phoning Freya Bank's customer service number",
      "continue": true,
      "source": "a:43"
    },
    {
      "id": "unknown_question",
      "description": "a question that cannot be answered from the tools",
      "say": "I do not have that information",
      "never_invent": [
        "figures",
        "dates",
        "reasons"
      ],
      "continue": true,
      "source": "a:44"
    },
    {
      "id": "does_not_want_to_talk",
      "max": 2,
      "close_verified": {
        "note": {
          "reason": "refused"
        },
        "applies_to": "products without a promise",
        "close": "per closing rule",
        "base": {
          "outcome": "no_promise",
          "reason": "refused"
        }
      },
      "close_unverified": {
        "outcome": "not_verified",
        "reason": "declined"
      },
      "source": "a:45",
      "unverified_note": "no products are known before get_account: no notes before verification"
    }
  ],
  "multi_product": {
    "state_all_products_first": true,
    "ask_all_today_first": true,
    "order": "get_account",
    "per_product_band_and_attempts": true,
    "single_date_after_deadline": "record that product on its own deadline, say so in the read-back; the other products keep the date the customer named",
    "single_confirmation_for_all": true,
    "create_promise_per_product": true,
    "note_tool": "add_note",
    "note_when": "every product that ends without a promise, including when no product gets a promise",
    "note_reasons": [
      "refused",
      "hardship",
      "dispute",
      "paid",
      "service_error"
    ],
    "dispute_or_paid_continues": true,
    "create_promise_failure": {
      "after_failed_tries": 2,
      "keep_recorded_promises": true,
      "note": {
        "reason": "service_error"
      }
    },
    "restructuring_request": {
      "transfer": "restructuring",
      "recorded_promises_stay": true,
      "agreed_but_unrecorded_promises_are_not_recorded": true,
      "close": {
        "outcome": "transferred",
        "reason": "restructuring"
      }
    },
    "no_notes_on_transfer": true,
    "closing_rule": "promise if any recorded (except restructuring transfer); else all products noted paid -> paid; else no_promise with the reason of the first product, in get_account order, whose note is not paid"
  },
  "closing": {
    "goodbye_before_close": true,
    "close_tool": "close_call",
    "exactly_one_close_call_and_it_is_last": true,
    "outcomes": [
      {
        "outcome": "promise",
        "reasons": [],
        "when": "at least one promise was recorded (except a restructuring transfer)"
      },
      {
        "outcome": "paid",
        "reasons": [],
        "when": "no promise recorded and every product is noted paid"
      },
      {
        "outcome": "transferred",
        "reasons": [
          "restructuring",
          "human",
          "support"
        ],
        "when": "rules 41, 42, 32"
      },
      {
        "outcome": "no_promise",
        "reasons": [
          "refused",
          "hardship",
          "dispute",
          "service_error"
        ],
        "when": "no promise recorded: reason of the first product, in get_account order, whose note is not paid; also a:31, a:45, a:32, a:40, a:37"
      },
      {
        "outcome": "not_verified",
        "reasons": [
          "failed",
          "declined"
        ],
        "when": "rules 14, 15"
      },
      {
        "outcome": "not_reached",
        "reasons": [
          "callback",
          "no_callback",
          "wrong_number",
          "deceased",
          "unclear"
        ],
        "when": "rules 6, 7, 8, 9, 3"
      }
    ],
    "transfer_after_promise": "close as transferred with the transfer reason",
    "unused_tools": [],
    "forbidden_offers": [
      "discount",
      "waiver",
      "instalment plan",
      "any term not in the brief"
    ],
    "multi_product_rule": "promise if any recorded (except restructuring transfer); else all products noted paid -> paid; else no_promise with the reason of the first product, in get_account order, whose note is not paid",
    "notes": "On any transfer (restructuring, support, human) add no notes at all, before or after it."
  },
  "tools_server": "https://freya-bank-mock.freyavoice.workers.dev/v1",
  "tools": {
    "verify_identity": {
      "summary": "Check one security answer. Three wrong answers in total end the check.",
      "method": "POST",
      "path": "/verify_identity",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "field": {
          "type": "string",
          "enum": [
            "date_of_birth",
            "phone_last4"
          ],
          "required": true
        },
        "answer": {
          "type": "string",
          "description": "For date_of_birth: the date as YYYY-MM-DD. Callers say dates in words, the agent converts. An unreadable value is rejected with ok=false and is not counted as a wrong answer. For phone_last4: four digits.",
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        },
        "verified": {
          "type": "boolean",
          "required": false
        },
        "wrong_answers_left": {
          "type": "integer",
          "required": false
        },
        "all_verified": {
          "type": "boolean",
          "required": false
        },
        "hint": {
          "type": "string",
          "enum": [
            "day_month_swapped"
          ],
          "required": false
        }
      }
    },
    "get_account": {
      "summary": "The late products. Refused until both questions are passed.",
      "method": "POST",
      "path": "/get_account",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        },
        "products": {
          "type": "array",
          "items": {
            "product_id": {
              "type": "string",
              "required": false
            },
            "type": {
              "type": "string",
              "enum": [
                "credit_card",
                "personal_loan",
                "car_loan"
              ],
              "required": false
            },
            "card_last4": {
              "type": "string",
              "description": "credit cards only",
              "required": false
            },
            "past_due": {
              "type": "number",
              "required": false
            },
            "days_late": {
              "type": "integer",
              "required": false
            },
            "minimum_payment": {
              "type": "number",
              "description": "credit cards only",
              "required": false
            },
            "instalment_amount": {
              "type": "number",
              "description": "loans only",
              "required": false
            }
          },
          "required": false
        }
      }
    },
    "create_promise": {
      "summary": "Record a payment promise. One per product.",
      "method": "POST",
      "path": "/create_promise",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "product_id": {
          "type": "string",
          "required": true
        },
        "amount": {
          "type": "number",
          "required": true
        },
        "date": {
          "type": "string",
          "format": "date",
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        },
        "promise_id": {
          "type": "string",
          "required": false
        }
      }
    },
    "add_note": {
      "summary": "Brief B: record why a product ended without a promise.",
      "method": "POST",
      "path": "/add_note",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "product_id": {
          "type": "string",
          "required": true
        },
        "reason": {
          "type": "string",
          "enum": [
            "refused",
            "hardship",
            "dispute",
            "paid",
            "service_error"
          ],
          "required": true
        },
        "text": {
          "type": "string",
          "required": false
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        }
      }
    },
    "schedule_callback": {
      "summary": "Book a callback.",
      "method": "POST",
      "path": "/schedule_callback",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "date": {
          "type": "string",
          "format": "date",
          "required": true
        },
        "time": {
          "type": "string",
          "description": "HH:MM",
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        }
      }
    },
    "transfer_to_agent": {
      "summary": "Hand the call to a person.",
      "method": "POST",
      "path": "/transfer_to_agent",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "queue": {
          "type": "string",
          "enum": [
            "restructuring",
            "general",
            "support"
          ],
          "required": true
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        }
      }
    },
    "close_call": {
      "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
      "method": "POST",
      "path": "/close_call",
      "fields": {
        "customer_id": {
          "type": "string",
          "required": true
        },
        "outcome": {
          "type": "string",
          "enum": [
            "promise",
            "paid",
            "transferred",
            "no_promise",
            "not_verified",
            "not_reached"
          ],
          "required": true
        },
        "reason": {
          "type": "string",
          "description": "Required for every outcome except promise and paid. See the table in the brief.",
          "required": false
        }
      },
      "response_fields": {
        "ok": {
          "type": "boolean",
          "required": false
        },
        "error": {
          "type": "string",
          "required": false
        }
      }
    }
  },
  "extra_rules": [
    {
      "source": "a:3",
      "text": "If the customer asks a question before confirming who they are (rules 4 and 43), answer it first; the identity ask that follows is the second ask."
    },
    {
      "source": "a:4",
      "text": "If asked whether you are a robot or an AI, say you are Freya Bank's digital assistant and continue."
    },
    {
      "source": "a:10",
      "text": "A relative may not answer the security questions and may not be told anything about the account, even if they offer to pay."
    },
    {
      "source": "a:11",
      "text": "Send a date of birth to verify_identity as YYYY-MM-DD whatever way the customer said it; the service rejects anything it cannot read as a date. A date given only as numbers is read as day, then month, then year."
    },
    {
      "source": "a:12",
      "text": "A wrong answer may be asked again; three wrong answers in total, on whichever question, end the check."
    },
    {
      "source": "a:30",
      "text": "A no to paying today with no date and no amount is a flat refusal; a date or amount the customer proposes is never a refusal."
    },
    {
      "source": "a:33",
      "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in the brief."
    },
    {
      "source": "a:36",
      "text": "A recorded promise cannot be changed or cancelled in the same call; if asked, say they can change it in the mobile app."
    },
    {
      "source": "b:6",
      "text": "If the customer names one date for everything and it is after one product's deadline, record that product on its own deadline and say so in the read-back. The other products keep the date the customer named."
    },
    {
      "source": "b:8",
      "text": "Call add_note with that product_id and a reason (refused, hardship, dispute, paid or service_error) for every product without a promise, also when no product gets a promise."
    },
    {
      "source": "b:9",
      "text": "A dispute or an 'already paid' claim on one product does not end the call: note it (dispute / paid) and continue with the other products."
    },
    {
      "source": "b:10",
      "text": "A restructuring request still transfers the call. Promises recorded before the request stay; promises agreed but not yet recorded are not recorded. Close as transferred / restructuring. On any transfer (restructuring, support, human) add no notes at all, before or after it."
    },
    {
      "source": "b:11",
      "text": "If one create_promise fails twice, keep the promises that were recorded and call add_note with reason service_error for the failed product."
    },
    {
      "source": "b:p3",
      "text": "With no promise recorded: if every product is noted paid, close as paid. Otherwise close as no_promise with the reason of the first product, in get_account order, whose note is not paid. With several products, promise wins whenever at least one promise was recorded, except for a restructuring transfer."
    }
  ],
