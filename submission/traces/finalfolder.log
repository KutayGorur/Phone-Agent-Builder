dition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"week\"},{\"variable\":\"offer_state\",\"operator\":\"not_equals\",\"operand\":\"none\"}]}]}},{\"target_node\":\"email_start\",\"description\":\"Caller wants the statement e-mailed\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"email\"},{\"variable\":\"offer_state\",\"operator\":\"not_equals\",\"operand\":\"none\"}]}]}},{\"target_node\":\"offer\",\"description\":\"Caller declined the other-card question; make the offer\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"no_or_done\"},{\"variable\":\"offer_state\",\"operator\":\"equals\",\"operand\":\"pending\"}]}]}},{\"target_node\":\"end_menu\",\"description\":\"Caller wants nothing more\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"no_or_done\"}]}}]},\"prep_reselect\":{\"name\":\"prep_reselect\",\"node_type\":\"code\",\"passthrough\":true,\"passthrough_default_transition\":\"select_card\",\"on_enter\":{\"type\":\"silent\"},\"pre_actions\":[{\"type\":\"function\",\"function\":{\"name\":\"code_exec\",\"handler\":\"__function__:code_exec\",\"parameters\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"string\",\"default\":\"import json\\ntry:\\n    el=json.loads(vars.get('elig_json') or '[]')\\n    names=[]\\n    for c in el:\\n        if c['name'] and c['name'] not in names:\\n            names.append(c['name'])\\n    q='Hangi kartınızın borcunu öğrenmek istersiniz?'\\n    ex=' veya '.join(names[:2])\\n    vars['stage_q']=q\\n    vars['sel_prompt']=q+(' Örneğin, '+ex+' diyebilirsiniz.' if ex else '')\\n    vars['sel_pool']=vars.get('elig_json')\\n    vars['sel_stage']='name'\\n    vars['sel_tri