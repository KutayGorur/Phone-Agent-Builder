bir iki üç dört\",\"sel_name\":\"Omega\",\"elig_n\":\"1\"},\"expect_vars\":{\"bal_mode\":\"nodebt\",\"reading_text\":\"Sonu bir iki üç dört ile biten Omega kartınızın 15 Şubat 2026 tarihli ekstresinden borcunuz bulunmamaktadır. Son ödeme tarihiniz 25 Mart 2026 olacaktır.\"}}},{\"op\":\"add\",\"path\":\"/tests/-\",\"value\":{\"name\":\"odd_email_shortened\",\"node\":\"calc_email\",\"vars\":{\"em_http\":\"200\",\"em_rc\":\"1\",\"em_addr\":\"mehmet_92@gmail.com\",\"bal_stmt\":\"01.01.2026\",\"elig_n\":\"1\"},\"expect_vars\":{\"email_say\":\"Ekstrenizi m ile başlayan Gmail adresinize göndermemi ister misiniz?\"}}},{\"op\":\"add\",\"path\":\"/tests/-\",\"value\":{\"name\":\"figure_request_due_only\",\"node\":\"read_prep\",\"vars\":{\"figure_req\":\"due\",\"fact_due\":\"Borçlarınız için son ödeme tarihiniz bugündür.\",\"closing_q\":\"X\",\"reading_text\":\"FULL\",\"bal_mode\":\"debt\"},\"expect_vars\":{\"read_say\":\"Borçlarınız için son ödeme tarihiniz bugündür. X\",\"read_mode\":\"full\"}}},{\"op\":\"replace\",\"path\":\"/coverage/19/implementation\",\"value\":\"read_prep routes one-figure requests (figure_req captured at card selection) to only that fact; debt plus e-mail reads the debt via read_only then goes to e-mail without the offer; cut-ins go to the offer.\"},{\"op\":\"replace\",\"path\":\"/coverage/26/implementation\",\"value\":\"Separate silence counter; first and second silence give a short repeat, only the third says the termination sentence and ends the call.\"}]}"}
