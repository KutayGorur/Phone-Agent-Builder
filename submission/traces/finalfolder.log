(rem,'TL')+' tutarı bulunmaktadır. '\\n        if pay:\\n            if K(pay)==K(today):\\n                fdue='Borçlarınız için son ödeme tarihiniz bugündür.'\\n            elif passed:\\n                tp=[A(F(G(c,'totalDebt')),c) for c in ('TL','USD','EUR','GBP') if B[c][0] and (F(G(c,'totalDebt')) or 0)>0]\\n                fdue='Borçlarınız için son ödeme tarihiniz geçmiş durumda.'+((' Toplam borcunuz '+', '.join(tp)+' tutarındadır.') if tp else '')\\n            else:\\n                fdue='Borçlarınız için son ödeme tarihiniz '+DU(pay,nw[0])+'.'\\n        txt+=fdue\\n    vars['reading_text']=txt.strip()\\n    vars['fact_due']=fdue\\n    vars['fact_min']=fmin\\n    vars['bal_mode']=mode\\n    if mode=='nodebt':\\n        vars['closing_q']='' if str(vars.get('elig_n'))=='1' else 'Başka bir kartınızın borcunu öğrenmek ister misiniz?'\\n        vars['offer_state']='none'\\n    vars['read_reply']=''\\n    vars['bal_state']='ok'\\nexcept Exception:\\n    vars['bal_state']='error'\\nvars['bal_http']=''\\nvars['bal_rc']=''\\n\"}, \"timeout_ms\": {\"type\": \"number\", \"default\": 10000}}}}}], \"transitions\": [{\"target_node\": \"end_agent_svc\", \"description\": \"balance failed\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"variable\": \"bal_state\", \"operator\": \"equals\", \"operand\": \"error\"}]}}, {\"target_node\": \"end_rdg\", \"description\": \"no debt, only one card\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"logic\": \"and\", \"conditions\": [{\"variable\": \"bal_mode\", \"operator\": \"equals\", \"operand\": \"nodebt\"}, {\"variable\": \"elig_n\", \"operator\": \"equals\", \"operand\": \"1\"}]}]}}, {\"target_node\": \"read_debt\", \"description\": \"no debt, other card question\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"variable\": \"bal_mode\", \"operator\": \"equals\", \"operand\": \"nodebt\"}]}}, {\"target_node\": \"fetch_email\", \"description\": \"debt: fetch e-mail before the offer\", \"condition\": {\"o