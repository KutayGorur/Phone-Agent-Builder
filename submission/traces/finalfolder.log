ssthrough_default_transition\":\"fetch_email\",\"on_enter\":{\"type\":\"silent\"},\"pre_actions\":[{\"type\":\"function\",\"function\":{\"name\":\"code_exec\",\"handler\":\"__function__:code_exec\",\"parameters\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"string\",\"default\":\"import json\\nU=['','bir','iki','üç','dört','beş','altı','yedi','sekiz','dokuz']\\nT=['','on','yirmi','otuz','kırk','elli','altmış','yetmiş','seksen','doksan']\\nM=['','Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık']\\nMS=['','tır','tır','tır','dır','tır','dır','dur','tur','dür','dir','dır','tır']\\nYS=['dır','dir','dir','tür','tür','tir','dır','dir','dir','dur']\\nCUR=dict(TL=('Türk Lirası','lira','kuruş'),USD=('Dolar','dolar','sent'),EUR=('Euro','euro','sent'),GBP=('İngiliz Sterlini','İngiliz Sterlini','peni'))\\nSF=dict(Lirası='dır',kuruş='tur',Dolar='dır',dolar='dır',Euro='dur',euro='dur',Sterlini='dir',sent='tir',peni='dir')\\nAPO=chr(39)\\ndef J(x):\\n    if isinstance(x,str):\\n        try:\\n            return json.loads(x)\\n        except Exception:\\n            return None\\n    return x\\ndef tri(n):\\n    s=''\\n    h=n//100\\n    if h:\\n        s=('' if h==1 else U[h]+' ')+'yüz '\\n    s+=T[n//10%10]+' '+U[n%10]\\n    return ' '.join(s.split())\\ndef W(n):\\n    if n==0:\\n        return 'sıfır'\\n    o=[]\\n    for v,nm in ((10**9,'milyar'),(10**6,'milyon'),(1000,'bin'),(1,'')):\\n        q=n//v\\n        n=n%v\\n        if q:\\n            o.append('bin' if nm=='bin' and q==1 else (tri(q)+' '+nm).strip())\\n    return ' '.join(o)\\ndef A(x,c):\\n    p=int(round(abs(float(x))*100))\\n    k=p%100\\n    n=CUR[c]\\n    if k==0:\\n        return W(p//100)+' '+n[0]\\n    return W(p//100)+' '+n[1]+' '+W(k)+' '+n[2]\\ndef E(x,c):\\n    a=A(x,c)\\n    return a+APO+SF.get(a.split()[-1],'dır')\\ndef DT(s):\\n    p=str(s).split('.')\\n    return str(int(p[0]))+' '+M[int(p[1])]+' '+p[2]\\ndef DN(s,y):\\n    p=str(s).split('.')\\n    return str(int(p[0]))+' '+M[int(p[1])]+((' '+p[2]) if p[2]!=y else '')\\ndef DU(s,y):\\n    p=str(s).split('.')\\n    r=str(int(p[0]))+' '+M[int(p[1])]\\n    if p[2]!=y:\\n        return r+' '+p[2]+APO+YS[int(p[2][-1])]\\n    return r+APO+MS[int(p[1])]\\ndef K(s):\\n    p=str(s).split('.')\\n    return (int(p[2]),int(p[1]),int(p[0]))\\ndef F(x):\\n    try:\\n        return float(x)\\n    except Exception:\\n        return None\\ndef G(b,k):\\n    o=J(vars.get('bal_'+b))\\n    if isinstance(o,dict) and o.get(k) is not None:\\n        return o.get(k)\\n    return vars.get('fetch_balance_response.data.data.debt'+b+'.'+k)\\ntry:\\n    sc=str(vars.get('bal_http') or vars.get('fetch_balance_response.status_code') or '')\\n    if not (sc=='200' and str(vars.get('bal_rc') or '')=='1'):\\n        raise ValueError('bad')\\n    nw=str(vars.get('now'))[:10].split('-')\\n    today=nw[2]+'.'+nw[1]+'.'+nw[0]\\n    st=str(vars.get('bal_stmt') or '').strip()\\n    pay=str(vars.get('bal_pay') or '').strip()\\n    nx=str(vars.get('bal_next') or '').strip()\\n    cut=(nx==today)\\n    l4=str(vars.get('sel_l4w'))\\n    nme=str(vars.get('sel_name') or '')\\n    pre=(nme+' ') if nme else ''\\n    intro='Sonu '+l4+' ile biten '+pre+'kartınıza ait'\\n    B=dict()\\n    for c in ('TL','USD','EUR','GBP'):\\n        r=F(G(c,'remainingDebt'))\\n        td=F(G(c,'totalDebt'))\\n        basis=td if cut else r\\n        B[c]=((r is not None) or (td is not None), basis is not None and basis>0)\\n    fdue=''\\n    fmin=''\\n    if not st and not pay:\\n        txt='Sonu '+l4+' ile biten '+pre+'kartınız için. Kartınızın henüz kesilmiş bir ekstresi olmadığı için ekstre borcunuz bulunmamaktadır.'\\n        if nx:\\n            txt+=' İlk hesap kesim tarihiniz '+DT(nx)+' olacak.'\\n        mode='nodebt'\\n    elif not any(v[1] for v in B.values()):\\n        txt='Sonu '+l4+' ile biten '+pre+'kartınızın '+((DT(st)+' tarihli ') if st else '')+'ekstresinden borcunuz bulunmamaktadır.'\\n        tt=F(G('TL','totalDebt'))\\n        if tt is not None and tt>0:\\n            txt+=' Gelecek dönemler dahil toplam borcunuz '+E(tt,'TL')+'.'\\n        if pay:\\n            txt+=' Son ödeme tarihiniz '+DN(pay,nw[0])+' olacaktır.'\\n        mode='nodebt'\\n    else:\\n        mode='debt'\\n        txt='Hesap kesim tarihiniz bugün, ekstreniz saat 00.00 itibarıyla kesilecek. ' if cut else ''\\n        lead=intro+' '+((DT(st)+' tarihinde kesilen ekstre ') if (st and not cut) else '')\\n        nod=[]\\n        first=True\\n        for c in ('TL','USD','EUR','GBP'):\\n            ex,hd=B[c]\\n            if not ex:\\n                continue\\n            if not hd:\\n                nod.append(CUR[c][0])\\n                continue\\n            sd=G(c,'statementDebt')\\n            mp=G(c,'minPayment')\\n            rd=G(c,'remainingDebt')\\n            td=G(c,'totalDebt')\\n            rm=F(G(c,'remainingMinPayment'))\\n            mpf=F(mp)\\n            nmc=CUR[c][0]\\n            if cut:\\n                s=nmc+' borcunuz '+E(td,c)+'.'\\n            elif c=='TL':\\n                if rm is None or (rm>0 and mpf is not None and rm>=mpf):\\n                    s='Türk Lirası borcunuz '+A(sd,c)+', ödenmesi gereken minimum tutar '+E(mp,c)+'.'\\n                elif rm<=0:\\n                    s='Türk Lirası borcunuz '+A(sd,c)+', kalan toplam borcunuz '+E(rd,c)+'. Minimum ödemenizi yaptığınız için teşekkür ederiz.'\\n                else:\\n                    s='Türk Lirası borcunuz '+A(sd,c)+', ödenmesi gereken minimum tutar '+A(mp,c)+', kalan toplam borcunuz '+A(rd,c)+', kalan minimum ödeme tutarınız '+E(rm,c)+'.'\\n            else:\\n                s=nmc+' borcunuz '+A(sd,c)+', kalan toplam borcunuz '+A(rd,c)+', ödenmesi gereken minimum tutar '+E(mp,c)+'.'\\n            if c=='TL' and not cut:\\n                fmin='Ödenmesi gereken minimum tutar '+E(mp,c)+'.'\\n            txt+=(lead if first else '')+s+' '\\n            first=False\\n        if nod:\\n            txt+=(nod[0] if len(nod)==1 else ', '.join(nod[:-1])+' ve '+nod[-1])+' borcunuz bulunmamaktadır. '\\n        passed=bool(pay) and K(pay)<K(today)\\n        rem=F(G('TL','remainAutomaticPaymentAmount'))\\n        if passed and str(vars.get('bal_flag'))=='Y' and rem is not None and rem>0:\\n            txt+='Otomatik ödeme talimatınız kapsamında henüz tahsil edilecek '+A(rem,'TL')+' tutarı bulunmaktadır. '\\n        if pay:\\n            if K(pay)==K(today):\\n                fdue='Borçlarınız için son ödeme tarihiniz bugündür.'\\n            elif passed:\\n                tp=[A(F(G(c,'totalDebt')),c) for c in ('TL','USD','EUR','GBP') if B[c][0] and (F(G(c,'totalDebt')) or 0)>0]\\n                fdue='Borçlarınız için son ödeme tarihiniz geçmiş durumda.'+((' Toplam borcunuz '+', '.join(tp)+' tutarındadır.') if tp else '')\\n            else:\\n                fdue='Borçlarınız için son ödeme tarihiniz '+DU(pay,nw[0])+'.'\\n        txt+=fdue\\n    vars['reading_text']=txt.strip()\\n    vars['fact_due']=fdue\\n    vars['fact_min']=fmin\\n    vars['bal_mode']=mode\\n    if mode=='nodebt':\\n        vars['closing_q']='' if str(vars.get('elig_n'))=='1' else 'Başka bir kartınızın borcunu öğrenmek ister misiniz?'\\n        vars['offer_state']='none'\\n    vars['read_reply']=''\\n    vars['bal_state']='ok'\\nexcept Exception:\\n    vars['bal_state']='error'\\nvars['bal_http']=''\\nvars['bal_rc']=''\\n\"},\"timeout_ms\":{\"type\":\"number\",\"default\":10000}}}}}],\"transitions\":[{\"target_node\":\"end_agent_svc\",\"description\":\"balance failed\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"variable\":\"bal_state\",\"operator\":\"equals\",\"operand\":\"error\"}]}},{\"target_node\":\"end_rdg\",\"description\":\"no debt, only one card\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"bal_mode\",\"operator\":\"equals\",\"operand\":\"nodebt\"},{\"variable\":\"elig_n\",\"operator\":\"equals\",\"operand\":\"1\"}]}]}},{\"