 çalışıyorum.','Sizi müşteri temsilcimize aktarıyorum.']\\n    vars['angry_say']=L[min(n,3)-1]\\nexcept Exception:\\n    pass\\n\"},\"timeout_ms\":{\"type\":\"number\",\"default\":10000}}}}}],\"excluded_nodes\":[\"end_menu\",\"end_xfer\",\"end_fail\",\"end_nocard\",\"end_rdg\",\"end_mail_no\",\"end_mail_ok\",\"end_week_ok\",\"end_third\",\"end_agent\",\"end_agent_q\",\"end_agent_pay\",\"end_agent_dis\",\"end_agent_svc\",\"end_agent_wk\",\"end_silent\"],\"transitions\":[{\"target_node\":\"end_agent_q\",\"description\":\"still complaining after three calming replies\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"variable\":\"angry_n\",\"operator\":\"greater_than\",\"operand\":3}]}},{\"target_node\":\"__previous__\",\"description\":\"continue the flow\",\"condition\":{\"operator\":\"always\"}}]},\"g_silence\":{\"name\":\"g_silence\",\"description\":\"Silence\",\"node_type\":\"code\",\"condition\":{\"operator\":\"matches_intent\",\"description\":\"The caller said nothing: empty message, silence or only noise\"},\"on_enter\":{\"type\":\"tts\",\"text\":\"{{silence_say}}\"},\"passthrough\":true,\"passthrough_default_transition\":\"__previous__\",\"pre_actions\":[{\"type\":\"function\",\"function\":{\"name\":\"code_exec\",\"handler\":\"__function__:code_exec\",\"parameters\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"string\",\"default\":\"try:\\n    n=int(vars.get('silence_n') or 0)+1\\n    vars['silence_n']=str(n)\\n    if n>=2:\\n        vars['silence_say']='Sesinizi alamadığım için görüşmeyi sonlandırıyorum.'\\nexcept Exception:\\n    pass\\n\"},\"timeout_ms\":{\"type\":\"number\",\"default\":10000}}}}}],\"excluded_nodes\":[\"end_menu\",\"end_xfer\",\"end_fail\",\"end_nocard\",\"end_rdg\",\"end_mail_no\",\"end_mail_ok\",\"end_week_ok\",\"end_third\",\"end_agent\",\"end_agent_q\",\"end_agent_pay\",\"end_agent_dis\",\"end_agent_svc\",\"end_agent_wk\",\"end_silent\"],\"transitions\":[{\"target_node\":\"end_silent\",\"description\":\"third silence ends 