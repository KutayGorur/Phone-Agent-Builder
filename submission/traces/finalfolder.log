ls\", \"operand\": \"other_card\"}]}}, {\"target_node\": \"week_start\", \"description\": \"Caller wants to change the statement date or week\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"logic\": \"and\", \"conditions\": [{\"variable\": \"read_reply\", \"operator\": \"equals\", \"operand\": \"week\"}, {\"variable\": \"offer_state\", \"operator\": \"not_equals\", \"operand\": \"none\"}]}]}}, {\"target_node\": \"email_start\", \"description\": \"Caller wants the statement e-mailed\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"logic\": \"and\", \"conditions\": [{\"variable\": \"read_reply\", \"operator\": \"equals\", \"operand\": \"email\"}, {\"variable\": \"offer_state\", \"operator\": \"not_equals\", \"operand\": \"none\"}]}]}}, {\"target_node\": \"offer\", \"description\": \"Caller declined the other-card question; make the offer\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"logic\": \"and\", \"conditions\": [{\"variable\": \"read_reply\", \"operator\": \"equals\", \"operand\": \"no_or_done\"}, {\"variable\": \"offer_state\", \"operator\": \"equals\", \"operand\": \"pending\"}]}]}}, {\"target_node\": \"end_menu\", \"description\": \"Caller wants nothing more\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"variable\": \"read_reply\", \"operator\": \"equals\", \"operand\": \"no_or_done\"}]}}, {\"target_node\": \"end_fail\", \"description\": \"turn limit after valid-answer transitions\", \"condition\": {\"operator\": \"greater_than\", \"variable\": \"read_debt.current_turns\", \"operand\": 2}}]}, \"prep_reselect\": {\"name\": \"prep_reselect\", \"node_type\": \"code\", \"passthrough\": true, \"passthrough_default_transition\": \"select_card\", \"on_enter\": {\"type\": \"silent\"}, \"pre_actions\": [{\"type\": \"function\", \"function\": {\"name\": \"code_exec\", \"handler\": \"__function__:code_exec\", \"parameters\": {\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"string\", \"default\": \"import json\\ntry:\\n    el=json.loads(vars.get('elig_json') or '[]')\\n    names=[]\\n    for c in el:\\n        if c['name'] and c['name'] not in names:\\n            names.append(c['name'])\\n    q='Hangi kartınızın borcunu öğrenmek istersiniz?'\\n    ex=' veya '.join(names[:2])\\n    vars['stage_q']=q\\n    vars['sel_prompt']=q+(' Örneğin, '+ex+' diyebilirsiniz.' if ex else '')\\n    vars['sel_pool']=vars.get('elig_json')\\n    vars['sel_stage']='name'\\n    vars['sel_tries']='0'\\n    for k in ('sel_kind','card_query','digits_said','read_reply'):\\n        vars[k]=''\\nexcept Exception:\\n    pass\\n\"}, \"timeout_ms\": {\"type\": \"number\", \"default\": 10000}}}}}], \"transitions\": [{\"target_node\": \"select_card\", \"description\": \"always\", \"condition\": {\"operator\": \"always\"}}]}, \"offer\": {\"name\": \"offer\", \"node_type\": \"conversation\", \"on_enter\": {\"type\": \"llm\"}, \"task_message\": \"Current user turns since entering this node: {{offer.current_turns}}. On entry, before the caller answers this node (zero turns), use these instructions:\\nNo tool call. Say exactly: {{offer_text}}\\nIf still in this node after a caller answer (one or more turns), use these instructions instead:\\nNo tool call. Briefly ask again: {{offer_text}}\", \"extraction_schema\": [{\"name\": \"offer_choice\", \"type\": \"string\", \"enum_values\": [\"week\", \"email\", \"none\", \"unclear\", \"\"], \"description\": \"week: wants the statement date changed. email: wants the statement e-mailed. none: nothing, thanks, goodbye. unclear otherwise.\", \"min_confidence\": 0.7}], \"transitions\": [{\"target_node\": \"week_start\", \"description\": \"Wants statement date change\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"variable\": \"offer_choice\", \"operator\": \"equals\", \"operand\": \"week\"}]}}, {\"target_node\": \"email_start\", \"description\": \"Wants statement e-mailed\", \"condition\": {\"logic\": \"or\", \"conditions\": [{\"variable\": \"offer_choice\", \"operato