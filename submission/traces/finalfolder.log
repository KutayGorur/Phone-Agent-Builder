\":\"Caller asks to hear it again; not a try\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"repeat\"}]}},{\"target_node\":\"prep_reselect\",\"description\":\"Caller wants another card's debt or to switch cards\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"other_card\"}]}},{\"target_node\":\"week_start\",\"description\":\"Caller wants to change the statement date or week\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"week\"},{\"variable\":\"offer_state\",\"operator\":\"not_equals\",\"operand\":\"none\"}]}]}},{\"target_node\":\"email_limit\",\"description\":\"E-mail request with unsupported qualifier\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"email\"},{\"variable\":\"email_qual\",\"operator\":\"equals\",\"operand\":\"unsupported\"},{\"variable\":\"offer_state\",\"operator\":\"not_equals\",\"operand\":\"none\"}]}]}},{\"target_node\":\"email_start\",\"description\":\"Caller wants the statement e-mailed\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"email\"},{\"variable\":\"offer_state\",\"operator\":\"not_equals\",\"operand\":\"none\"}]}]}},{\"target_node\":\"offer\",\"description\":\"Caller declined the other-card question; make the offer\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"no_or_done\"},{\"variable\":\"offer_state\",\"operator\":\"equals\",\"operand\":\"pending\"}]}]}},{\"target_node\":\"end_menu\",\"description\":\"Caller wants nothing more\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"variable\":\"read_reply\",\"operator\":\"equals\",\"operand\":\"no_or_done\"}]}},{\"target_node\":\"end_fail\",\"description\":\"turn limit after valid-answer transitions\",\"condition\":{\"operator\":\"greater_than\",\"variable\":\"read_debt.current_turns\",\"operand\":2}}]},{\"op\":\"replace\",\"path\":\"/workflow/nodes/offer/extraction_schema\",\"value\":[{\"name\":\"offer_choice\",\"type\":\"string\",\"enum_values\":[\"week\",\"email\",\"none\",\"repeat\",\"unclear\",\"\"],\"description\":\"week: wants the statement date changed. email: wants the statement e-mailed. none: nothing, thanks, goodbye. repeat: asks to hear it again. unclear otherwise.\",\"min_confidence\":0.7},{\"name\":\"email_qual\",\"type\":\"string\",\"enum_values\":[\"unsupported\",\"none\",\"\"],\"description\":\"unsupported if the caller wants an earlier or last month's statement, another e-mail address, paper or SMS; otherwise none.\",\"min_confidence\":0.7},{\"name\":\"week_pick\",\"type\":\"integer\",\"description\":\"Week number 1 to 4 only if the caller explicitly names a week of the month for the statement date; otherwise 0.\",\"min_confidence\":0.8}]},{\"op\":\"replace\",\"path\":\"/workflow/nodes/offer/transitions\",\"value\":[{\"target_node\":\"offer\",\"description\":\"Repeat request; not a try\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"variable\":\"offer_choice\",\"operator\":\"equals\",\"operand\":\"repeat\"}]}},{\"target_node\":\"week_start\",\"description\":\"Wants statement date change\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"variable\":\"offer_choice\",\"operator\":\"equals\",\"operand\":\"week\"}]}},{\"target_node\":\"email_limit\",\"description\":\"E-mail with unsupported qualifier\",\"condition\":{\"logic\":\"or\",\"conditions\":[{\"logic\":\"and\",\"conditions\":[{\"variable\":\"offer_choice\",\"operator\":\"equals\",\"operand\":\"email\"},{\"variable\":\"email_qual\",\"operator\":\"equals\",\"operand\":\"unsupported\"}]}]}},{\"target_node\":\"email_start\",\"d